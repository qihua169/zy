    "rules": [
        {
            "name": "TVBox·云端去广告JS注入【增强版】",
            "hosts": [
                "vip.wwgz.cn",
                "lziplayer.com",
                "m3u8.apibdzy.com",
                "cj.ffzyapi.com",
                "api.hbzyapi.com",
                "toutiaovod.com",
                "huoshan.com",
                "douyin.com",
                "www.maolvys.com"
            ],
            "script": [
                "(function(){",
                "    // 保存原始方法快照",
                "    const _origFuncCtor = Function.prototype.constructor;",
                "    const _origAlert = window.alert;",
                "    const _origConfirm = window.confirm;",
                "    const _origPrompt = window.prompt;",
                "    const _origOpen = window.open;",
                "",
                "    // 1. 屏蔽弹窗广告",
                "    window.alert = ()=>{};",
                "    window.confirm = ()=>false;",
                "    window.prompt = ()=>null;",
                "",
                "    // 2. 拦截广告新窗口跳转",
                "    window.open = function(){ return null; };",
                "",
                "    // 3. 拦截动态生成 debugger（原有逻辑优化）",
                "    Function.prototype.constructor = function(){",
                "        const str = Array.from(arguments).join('');",
                "        if(str.includes('debugger')) return function(){};",
                "        return _origFuncCtor.apply(this,arguments);",
                "    };",
                "",
                "    // 4. 压制静态 debugger（主流反调试方案）",
                "    Object.defineProperty(window,'debugger',{ configurable:false, get:()=>{} });",
                "",
                "    // 5. 视频自动静音，规避有声广告",
                "    function initVideo(){",
                "        document.querySelectorAll('video').forEach(v=>{",
                "            v.muted=true;",
                "            v.play().catch(()=>{});",
                "            // 阻止视频被广告脚本暂停",
                "            v.addEventListener('pause',()=>{ setTimeout(()=>v.play().catch(()=>{}),100); });",
                "        });",
                "    }",
                "",
                "    // 6. 扩容通用广告选择器",
                "    const adSelectors = [",
                "        '.adv','.ads','.ad','.pop','.popup','.pop-banner','.pop-ad','.notice','#notice-modal',",
                "        '[class*=\"adv\"]','[class*=\"ads\"]','[class*=\"pop\"]','[class*=\"banner\"]','[class*=\"guide\"]',",
                "        '[id*=\"adv\"]','[id*=\"ads\"]','[id*=\"pop\"]','[id*=\"banner\"]','[id*=\"notice\"]',",
                "        'iframe[src*=\"game\"]','iframe[src*=\"bet\"]','iframe[src*=\"ad\"]','iframe[src*=\"baidu\"]',",
                "        'a[href*=\"999\"]','a[href*=\"game\"]','a[href*=\"bet\"]','div[onclick*=\"location\"]'",
                "    ];",
                "",
                "    // 7. 循环清理广告，页面卸载自动销毁定时器防内存泄漏",
                "    const adTimer = setInterval(()=>{",
                "        adSelectors.forEach(sel=>{",
                "            document.querySelectorAll(sel).forEach(el=>{",
                "                try{ el.remove(); }catch(e){}",
                "            });",
                "        });",
                "        initVideo();",
                "    },350);",
                "",
                "    window.addEventListener('beforeunload',()=>clearInterval(adTimer));",
                "",
                "    // 8. 页面初次就绪执行一次",
                "    if(document.readyState==='loading'){",
                "        document.addEventListener('DOMContentLoaded',initVideo);",
                "    }else{",
                "        initVideo();",
                "    }",
                "})();"
            ]
        },
